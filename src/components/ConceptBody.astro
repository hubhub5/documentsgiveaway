---
import Sec from './Sec.astro';
import Wiki from './Wiki.astro';
import Grade from './Grade.astro';
import { registry, sourceUrl } from '../lib/docs';
interface Props { d: any; title: string }
const { d, title } = Astro.props;
const reg = await registry();
const users = (reg.back.get(title) ?? []);
const problems = users.filter((x) => x.kind === 'problem');
const methods = users.filter((x) => x.kind === 'method');
---
<div class="info">
  <div class="row"><span>원어</span><span>{d.en}</span></div>
  <div class="row"><span>제안</span><span>{d.origin}</span></div>
  <div class="row"><span>분야</span><span>{d.field}</span></div>
  <div class="row"><span>근거 수준</span><span><Grade g={d.grade} long /></span></div>
  <div class="row"><span>반복 검증</span><span>{d.replication}</span></div>
  {d.caveat && <div class="row"><span>주의</span><span><Wiki t={d.caveat} /></span></div>}
</div>

<Sec n="01" id="studies" title="핵심 연구">
  <div class="scroll-x">
    <table class="tbl">
      <thead><tr><th>연구</th><th>대상</th><th>결과</th></tr></thead>
      <tbody>{d.studies.map((s: any) => {
        const src = reg.sources.get(s.source)!;
        return <tr><td><a class="wl" href={sourceUrl(s.source)}>{src.authors.split(',')[0].replace(/ .*$/, '')}{src.authors.includes(',') ? ' 외' : ''} {src.year}</a></td><td>{s.who}</td><td><Wiki t={s.result} /></td></tr>;
      })}</tbody>
    </table>
  </div>
</Sec>

{d.examples.length > 0 && (
  <Sec n="02" id="examples" title="생활에서 들리는 말">
    <div class="says">{d.examples.map((s: any) => <div class="say"><span>{s.who}</span><q>{s.text}</q></div>)}</div>
  </Sec>
)}

<Sec n="03" id="used" title="이 개념이 쓰이는 곳" note="자동 집계">
  <div class="two">
    <div class="note-box"><h3>문제 {problems.length}</h3><ul class="plain">{problems.length ? problems.map((p) => <li><a class="wl" href={p.url}>{p.title}</a></li>) : <li class="mute">아직 없음</li>}</ul></div>
    <div class="note-box"><h3>방법 {methods.length}</h3><ul class="plain">{methods.length ? methods.map((p) => <li><a class="wl" href={p.url}>{p.title}</a></li>) : <li class="mute">아직 없음</li>}</ul></div>
  </div>
</Sec>
