---
interface Props { g: 'A' | 'B' | 'C' | 'D'; long?: boolean }
const { g, long } = Astro.props;
const label = { A: '메타분석·반복 연구', B: '무작위 실험', C: '상관·이론', D: '현장 관찰' }[g];
---
<a class="grade" data-g={g} href="/근거등급/" title={`근거 등급 ${g}: ${label}`}><i></i>{g}{long && <span class="mute">&nbsp;{label}</span>}</a>
