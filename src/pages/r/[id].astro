---
import '../../styles/doc.css';
import Base from '../../layouts/Base.astro';
import { registry } from '../../lib/docs';
export async function getStaticPaths() {
  const reg = await registry();
  return [...reg.sources.keys()].map((id) => ({ params: { id } }));
}
const reg = await registry();
const s = reg.sources.get(Astro.params.id!)!;
const by = reg.citedBy.get(s.id) ?? [];
---
<Base title={`${s.authors} (${s.year})`} description={`${s.title} — ${s.note}`}>
  <div class="wrap page" style="max-width:820px">
    <div class="doc-meta mono"><b>R · {s.id}</b><span>{s.type}</span><span>인용 {by.length}</span></div>
    <h1 class="doc-title" style="font-size:24px;letter-spacing:-0.02em">{s.title}</h1>
    <p class="doc-crumb">{s.authors} · {s.year}</p>
    <p class="doc-line">{s.note}</p>
    <div class="info">
      <div class="row"><span>저자</span><span>{s.authors}</span></div>
      <div class="row"><span>연도</span><span class="mono">{s.year}</span></div>
      <div class="row"><span>수록</span><span>{s.venue}{s.volume && `, ${s.volume}`}{s.pages && `, ${s.pages}`}</span></div>
      <div class="row"><span>연구 유형</span><span>{s.type}</span></div>
      {s.doi && <div class="row"><span>DOI</span><span><a class="wl mono" href={`https://doi.org/${s.doi}`} target="_blank" rel="noopener">{s.doi}</a></span></div>}
    </div>
    <section class="sec"><div class="sec-h"><span class="mono">←</span><h2>이 출처를 인용한 문서</h2><small>{by.length}</small></div>
      <ul class="plain">{by.length ? by.map((d) => <li><span class="mono mute" style="margin-right:10px">{d.id}</span><a class="wl" href={d.url}>{d.title}</a></li>) : <li class="mute">아직 없음</li>}</ul>
    </section>
  </div>
</Base>
