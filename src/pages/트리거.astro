---
import Base from '../layouts/Base.astro';
import Grade from '../components/Grade.astro';
import AdSlot from '../components/AdSlot.astro';
import { registry, wiki } from '../lib/docs';

const reg = await registry();
const secs = (t: string) => {
  if (t === '바로') return 0;
  const m = t.match(/(\d+)\s*(초|분)/);
  return m ? Number(m[1]) * (m[2] === '분' ? 60 : 1) : 9999;
};
const rows = reg.docs.filter((d) => d.kind === 'problem')
  .flatMap((d) => d.data.triggers.map((t: any) => ({ ...t, doc: d, s: secs(t.time) })))
  .sort((a, b) => a.s - b.s);
const whos = ['본인', '엄마', '같이'];
---
<Base title="트리거 모음" current="트리거" description="무너지던 흐름을 되돌리는 짧은 행동만 모았습니다. 시간 짧은 순.">
  <div class="wrap page">
    <div class="page-head"><p class="kicker mono">TRIGGERS · {rows.length}</p><h1>트리거 모음</h1><p>모든 문제 문서의 '다시 살아나는 트리거'만 모아 시간 짧은 순으로 놓았습니다.</p></div>
    <div class="who mono" role="group" aria-label="누가">
      <button class="on" data-w="">전체</button>{whos.map((w) => <button data-w={w}>{w}</button>)}
    </div>
    <div class="scroll-x">
      <table class="tbl trig-all">
        <thead><tr><th>시간</th><th>트리거</th><th>언제</th><th>누가</th><th>근거</th><th>문서</th></tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr data-who={r.who}>
              <td class="mono">{r.time}</td>
              <td><b set:html={wiki(r.text, reg)} /></td>
              <td>{r.when}</td>
              <td>{r.who}</td>
              <td><Grade g={r.grade} /></td>
              <td><a class="wl" href={r.doc.url}>{r.doc.title}</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <AdSlot name="DOC-END" />
  </div>
</Base>
<style>
  .who { display: flex; margin-bottom: 14px; }
  .who button { border: 1px solid var(--line-2); padding: 4px 10px; margin-right: -1px; color: var(--mute); }
  .who button.on { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .trig-all b { font-weight: 700; }
  .trig-all td:last-child { font-size: 13px; }
  .trig-all { min-width: 760px; }
</style>
<script>
  document.querySelectorAll<HTMLButtonElement>('.who button').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('.who button').forEach((x) => x.classList.toggle('on', x === b));
    document.querySelectorAll<HTMLElement>('.trig-all tbody tr').forEach((tr) => {
      tr.hidden = !!b.dataset.w && tr.dataset.who !== b.dataset.w;
    });
  }));
</script>
